---
/**
 * The one floating control (DESIGN.md → Controls): Back to top, with a lime ring that fills as you read. It appears after
 * one and a half screens of scrolling, sits inside the phone's safe area, and is the only thing that floats (no chat
 * bubble, no sticky CTA on top of it). With Motion off the jump is instant. Without JavaScript it is a plain "#top"
 * link at the end of the page instead (the footer has one), so this stays hidden.
 */
import Icon from './ui/Icon.astro';
---

<div class="dock" data-dock hidden>
  <button class="dock__top" type="button" data-to-top aria-label="Back to top">
    <svg class="dock__ring" viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="24" r="22" pathLength="1" />
      <circle class="dock__fill" cx="24" cy="24" r="22" pathLength="1" data-ring />
    </svg>
    <Icon name="arrow-up" />
  </button>
</div>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const btn = dock?.querySelector<HTMLButtonElement>('[data-to-top]');
  const ring = dock?.querySelector<SVGCircleElement>('[data-ring]');
  if (dock && btn) {
    dock.hidden = false;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = scrollY;
      const max = document.documentElement.scrollHeight - innerHeight;
      dock.classList.toggle('is-on', y > innerHeight * 1.5);
      ring?.style.setProperty('stroke-dashoffset', String(1 - (max > 0 ? Math.min(1, y / max) : 0)));
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    btn.addEventListener('click', () => {
      const on = document.documentElement.getAttribute('data-motion') === 'on';
      scrollTo({ top: 0, behavior: on ? 'smooth' : 'auto' });
      // Focus goes back to the start of the page, as the skip link would expect.
      const first = document.querySelector<HTMLElement>('[data-header] a') ?? document.getElementById('main');
      first?.focus({ preventScroll: true });
    });
    update();
  }
</script>

<style>
  .dock {
    position: fixed;
    right: max(var(--s-4), env(safe-area-inset-right));
    bottom: max(var(--s-4), env(safe-area-inset-bottom));
    z-index: 40;
    pointer-events: none;
  }
  .dock__top {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--text);
    box-shadow: var(--shadow-float);
    opacity: 0;
    transform: translateY(12px);
    /* Hidden from keyboards and screen readers until it appears (visibility flips after the fade out). */
    visibility: hidden;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1),
      visibility 0s linear var(--dur-2);
  }
  .dock.is-on {
    pointer-events: auto;
  }
  .dock.is-on .dock__top {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }
  .dock__top:hover,
  .dock__top:focus-visible {
    color: var(--signal);
  }
  .dock__top:focus-visible {
    outline-offset: 3px;
    border-radius: 50%;
  }
  .dock__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    fill: none;
    stroke-width: 2;
  }
  .dock__ring circle {
    stroke: var(--line);
  }
  .dock__ring .dock__fill {
    stroke: var(--signal);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  /* Not shown while the menu dialog or quick menu is open (they are modal and cover it anyway). */
  @media print {
    .dock {
      display: none;
    }
  }
</style>
