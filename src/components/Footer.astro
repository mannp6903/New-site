---
/**
 * Footer (MANN / IN MOTION): the final frame of the experience. The closing call to action (hidden on the contact page)
 * is an oversized line that the lime line runs into; then the real contact routes, link columns, the Motion switch, and
 * the MΛNN PΛTEL wordmark across the full width as the last thing on every page.
 */
import { profile, businesses, gbp, footerPages } from '../data/site';
import { groups } from '../data/services';
import { moreServicePages, servicePageForGroup } from '../data/service-pages';
import { pricesPublished } from '../data/packages';
import { contact, emailHref } from '../lib/contact';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import ContactActions from './ContactActions.astro';
import SocialLinks from './SocialLinks.astro';
import Wordmark from './ui/Wordmark.astro';
import { businessHref } from '../lib/work';
import { areaHref, visibleAreas, visibleNav } from '../lib/published';
import { areaPath } from '../data/areas';

interface Props {
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
const mail = emailHref();
const nest = businesses[0];
const scarborough = areaHref('scarborough');
const nav = await visibleNav();
const otherAreas = visibleAreas().filter((a) => a.name !== profile.location);
const footerMore = moreServicePages.filter((sp) => sp.slug === 'website-care' || sp.slug === 'ai-search-optimization');
---

<footer class="ftr" id="footer">
  {
    cta && (
      <section class="ftr__cta container" aria-labelledby="ftr-cta-title">
        <p class="eyebrow">Final frame · Next step</p>
        <h2 id="ftr-cta-title" class="ftr__title" data-split>
          <span class="line-mask" style="--i:0"><span>Tell me what</span></span>{' '}
          <span class="line-mask" style="--i:1"><span>isn’t working<span class="stop">.</span></span></span>
        </h2>
        <svg class="ftr__line" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
          <path class="draw-on-scroll" pathLength="1" d="M0 20 H1180" />
          <circle cx="1188" cy="20" r="6" />
        </svg>
        <div class="ftr__cta-row">
          <p class="lead ftr__lead">
            A short brief takes two minutes. I read every one myself and reply by email, usually with a few questions or a suggested first step.
          </p>
          <div class="ftr__actions">
            <div class="btn-row">
              <Button href="/contact/" data-magnetic>Start a project</Button>
              <Button href="/contact/?package=check-up#check" variant="ghost">
                Free website check
              </Button>
            </div>
            <ContactActions label="Or reach me directly" class="ftr__reach" />
          </div>
        </div>
      </section>
    )
  }

  <div class="ftr__grid container">
    <nav class="ftr__col" aria-label="Footer">
      <p class="ftr__h">Pages</p>
      <ul role="list">
        <li><a class="link-quiet" href="/">Home</a></li>
        {[...nav, ...footerPages].map((n) => <li><a class="link-quiet" href={n.href}>{n.label}</a></li>)}
        <li><a class="link-quiet" href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <div class="ftr__col">
      <p class="ftr__h">Services</p>
      <ul role="list">
        {groups.map((g) => {
          const sp = servicePageForGroup(g.id);
          return <li><a class="link-quiet" href={sp ? `/services/${sp.slug}/` : `/services/#${g.id}`}>{sp ? sp.short : g.title}</a></li>;
        })}
        {footerMore.map((sp) => <li><a class="link-quiet" href={`/services/${sp.slug}/`}>{sp.short}</a></li>)}
        <li><a class="link-quiet" href={pricesPublished ? '/pricing/' : '/services/#packages'}>{pricesPublished ? 'Pricing' : 'Packages'}</a></li>
        {otherAreas.map((a) => <li><a class="link-quiet" href={areaPath(a)}>Web design in {a.name}</a></li>)}
        <li><a class="link-quiet" href="/services/#check">Free website and Google check</a></li>
      </ul>
    </div>
    <div class="ftr__col ftr__col--wide">
      <p class="ftr__h">Contact</p>
      <ul role="list">
        {
          contact.email && (
            <li class="ftr__email">
              <a class="link-quiet" href={mail} data-contact="email">
                {contact.email}
              </a>
              <button class="copy" type="button" data-copy={contact.email}>
                <Icon name="copy" />
                <span class="visually-hidden">Copy email address</span>
              </button>
            </li>
          )
        }
        {
          contact.phone && (
            <li class="ftr__phone">
              <a class="link-quiet num" href={contact.phone.tel} data-reach="call" data-k={contact.phone.key} data-contact="phone">
                <Icon name="phone" />
                <span class="visually-hidden">Call </span>
                {contact.phone.display}
              </a>
            </li>
          )
        }
        {
          contact.phone && (
            <li class="ftr__phone">
              <a class="link-quiet" href="/contact/#reach" data-reach="whatsapp" data-k={contact.phone.key} data-contact="whatsapp" rel="noopener">
                <Icon name="whatsapp" />
                Message on WhatsApp
              </a>
            </li>
          )
        }
        {
          profile.contact.replyTime && (
            <li class="subtle" data-reply-time>
              <span>{profile.contact.replyTime}</span>
            </li>
          )
        }
        <li class="subtle">
          <span>Based in {scarborough ? <a class="ftr__area" href={scarborough}>{profile.location}</a> : profile.location}, working across {profile.serviceArea}.</span>
        </li>
      </ul>
    </div>
    <div class="ftr__col">
      <p class="ftr__h">Elsewhere</p>
      <SocialLinks class="ftr__social" />
      <ul role="list">
        <li>
          <a class="link-quiet" href={businessHref(nest)} rel={nest.siteLive ? 'noopener' : undefined}>
            {nest.name}
            <Icon name={nest.siteLive ? 'arrow-ne' : 'arrow'} />
          </a>
        </li>
        {
          gbp.reviewUrl && (
            <li>
              <a class="link-quiet" href={gbp.reviewUrl} rel="noopener" data-review-link>
                Clients: leave a Google review
                <Icon name="arrow-ne" />
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="ftr__name container" aria-hidden="true">
    <Wordmark class="ftr__wm" />
  </div>

  <div class="ftr__bottom container">
    <p>© {year} {profile.name} · Toronto, Canada</p>
    <p class="num ftr__clock">
      <span class="status__dot" aria-hidden="true"></span>
      Toronto time <time data-clock>--:--</time>
    </p>
    <div class="ftr__legal">
      <button class="switch" type="button" data-motion-toggle aria-pressed="true">
        <span class="switch__label">Motion</span>
        <span class="switch__track" aria-hidden="true"><i></i></span>
        <span class="switch__state" data-motion-state>On</span>
      </button>
      <a class="link-quiet" href="/privacy/">Privacy</a>
      <a class="link-quiet" href="/terms/">Terms</a>
      <a class="link-quiet ftr__top" href="#main">Back to top <Icon name="arrow-up" /></a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    margin-top: auto;
    overflow: clip;
    background: var(--ink);
    border-top: 1px solid var(--line);
  }
  .ftr__cta {
    display: grid;
    row-gap: var(--head-gap-2);
    padding-block: var(--section) var(--section-tight);
  }
  .ftr__cta > .eyebrow {
    margin-bottom: calc(var(--head-gap-1) - var(--head-gap-2));
  }
  .ftr__title {
    font-size: var(--fs-display);
    line-height: 0.92;
    max-width: 11ch;
  }
  .ftr__line {
    width: 100%;
    height: 1.5rem;
    overflow: visible;
    fill: none;
  }
  .ftr__line path {
    stroke: var(--signal);
    stroke-width: var(--line-w);
    vector-effect: non-scaling-stroke;
  }
  .ftr__line circle {
    fill: var(--signal);
  }
  .ftr__cta-row {
    display: grid;
    gap: var(--s-6);
    align-items: start;
  }
  .ftr__lead {
    max-width: 40ch;
  }
  .ftr__actions {
    display: grid;
    gap: var(--s-5);
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
    padding-block: var(--s-8);
    border-top: 1px solid var(--line);
  }
  .ftr__h {
    margin-bottom: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--w-ui);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .ftr__col ul {
    display: grid;
    gap: var(--s-1);
  }
  .ftr__col li {
    font-size: var(--fs-sm);
  }
  .ftr__col--wide {
    grid-column: 1 / -1;
  }
  .link-quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap);
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .link-quiet:hover,
  .link-quiet:focus-visible {
    color: var(--text);
  }
  .link-quiet :global(.icon) {
    width: 1em;
    height: 1em;
  }
  .ftr__email {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .copy {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    background: transparent;
    color: var(--text-3);
    transition: color var(--dur-1);
  }
  .copy:hover,
  .copy:focus-visible {
    color: var(--signal);
  }
  .copy :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .ftr__area {
    color: var(--text-2);
  }
  .ftr__name {
    padding-block: var(--s-6) var(--s-4);
    color: var(--text);
  }
  .ftr__name :global(.ftr__wm) {
    width: 100%;
    height: auto;
  }
  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-4) max(var(--s-6), env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
  .ftr__clock {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-label);
  }
  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-4);
  }
  .ftr__top :global(.icon) {
    width: 0.95em;
    height: 0.95em;
  }
  @media (min-width: 48em) {
    .ftr__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .ftr__col--wide {
      grid-column: auto;
    }
  }
  @media (min-width: 64em) {
    .ftr__cta-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>
