---
/**
 * Header (MANN / IN MOTION). Desktop: wordmark, a live line (Toronto time, taking projects), the main links, the ⌘K
 * quick menu and one call to action. Phones: wordmark + Menu. The hairline under the bar is the lime line in reading
 * progress; across page changes it is the shared element that redraws (view-transition-name: site-line).
 * The menu is a native <dialog>: focus is contained, Escape closes, focus returns to the Menu button. Its contents join
 * the page on first open. Without JavaScript the links show as a plain row instead.
 */
import { primaryCta, profile } from '../data/site';
import { contact, emailHref } from '../lib/contact';
import { visibleNav } from '../lib/published';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import Wordmark from './ui/Wordmark.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const nav = await visibleNav();
const sheetLinks = [{ href: '/', label: 'Home' }, ...nav, { href: '/contact/', label: 'Contact' }];
const mail = emailHref();
---

<header class="hdr" data-header>
  <div class="hdr__bar container">
    <a class="hdr__brand wordmark" href="/" aria-label={`${profile.name}, home`}>
      <Wordmark class="hdr__logo wordmark__logo" cut="small" />
    </a>

    <p class="hdr__live mono" aria-hidden="true">
      <span class="hdr__dot"></span>
      <span>TOR <time data-clock>--:--</time></span>
      <span class="hdr__sep">/</span>
      <span>Taking new projects</span>
    </p>

    <nav class="hdr__nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="roll">
                  <span data-text={item.label}>{item.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      <button class="qm-trigger" type="button" data-qm-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" />
        <span class="visually-hidden">Open quick menu</span>
        <kbd aria-hidden="true"><span data-mod>Ctrl</span> K</kbd>
      </button>
      <Button href={primaryCta.href} size="sm" class:list={['hdr__cta', path === '/' && 'is-quiet']} data-hdr-cta aria-current={path.startsWith('/contact/') ? 'page' : undefined}>{primaryCta.label}</Button>
      <button class="menu-btn" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false">
        <span class="menu-btn__text">Menu</span>
        <span class="menu-btn__lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <div class="hdr__line" aria-hidden="true"><i data-read></i></div>

  <dialog class="sheet" id="site-menu" aria-label="Site menu" data-menu>
    <template data-menu-content>
      <div class="sheet__inner">
        <div class="sheet__top">
          <p class="eyebrow">Menu</p>
          <button class="icon-btn sheet__close" type="button" data-menu-close>
            <Icon name="close" />
            <span class="visually-hidden">Close menu</span>
          </button>
        </div>
        <nav aria-label="Menu">
          <ol class="sheet__links" role="list">
            {
              sheetLinks.map((item, i) => (
                <li style={`--i:${i}`}>
                  <a href={item.href} aria-current={isCurrent(item.href) && (item.href !== '/' || path === '/') ? 'page' : undefined}>
                    <span class="sheet__n num" aria-hidden="true">
                      0{i + 1}
                    </span>
                    <span class="sheet__label">{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
        <div class="sheet__foot">
          <Button href="/contact/?package=check-up#check" class="sheet__cta">Get a free website check</Button>
          <ul class="sheet__reach" role="list">
            {
              contact.email && (
                <li>
                  <a href={mail} data-contact="email" aria-label={`Email Mann at ${contact.email}`}>
                    <Icon name="mail" />
                    {contact.email}
                  </a>
                </li>
              )
            }
            {
              contact.phone && (
                <li>
                  <a class="num" href={contact.phone.tel} data-reach="call" data-k={contact.phone.key} data-contact="phone">
                    <Icon name="phone" />
                    <span class="visually-hidden">Call </span>
                    {contact.phone.display}
                  </a>
                </li>
              )
            }
          </ul>
          <div class="sheet__meta">
            <button class="switch" type="button" data-motion-toggle aria-pressed="true">
              <span class="switch__label">Motion</span>
              <span class="switch__track" aria-hidden="true"><i></i></span>
              <span class="switch__state" data-motion-state>On</span>
            </button>
            <p class="sheet__legal small subtle">
              <a href="/privacy/">Privacy</a><span aria-hidden="true"> · </span><a href="/terms/">Terms</a>
            </p>
          </div>
        </div>
      </div>
    </template>
  </dialog>
</header>

<script>
  import { syncMotionSwitches } from '../scripts/prefs';

  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    // Solid bar once the page scrolls; reading progress on the lime line (rAF-throttled, transform only).
    const bar = header.querySelector<HTMLElement>('[data-read]');
    // Browsers with scroll timelines draw the progress in CSS; others get it from here.
    const cssProgress = CSS.supports('animation-timeline: scroll()');
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const y = window.scrollY;
        header.classList.toggle('is-scrolled', y > 8);
        if (!cssProgress) {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar?.style.setProperty('--p', String(max > 0 ? Math.min(1, y / max) : 0));
        }
      });
    };
    if ('requestIdleCallback' in window) requestIdleCallback(onScroll, { timeout: 1000 });
    else setTimeout(onScroll, 1);
    addEventListener('scroll', onScroll, { passive: true });

    const sheet = header.querySelector<HTMLDialogElement>('[data-menu]')!;
    const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;
    const closeSheet = () => {
      if (!sheet.open || sheet.classList.contains('is-closing')) return;
      sheet.classList.add('is-closing');
      const done = () => {
        sheet.classList.remove('is-closing');
        sheet.close();
      };
      const exit = sheet.getAnimations().find((a) => (a as CSSAnimation).animationName === 'sheet-out');
      if (!exit) done();
      else exit.finished.then(done, done);
    };
    openBtn.addEventListener('click', () => {
      const content = sheet.querySelector<HTMLTemplateElement>('template[data-menu-content]');
      if (content) {
        content.replaceWith(content.content);
        syncMotionSwitches();
        import('../scripts/reach').then((m) => m.fillReach(sheet));
      }
      sheet.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    sheet.addEventListener('close', () => {
      sheet.classList.remove('is-closing');
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    sheet.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeSheet();
    });
    sheet.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target.closest('[data-menu-close]')) return closeSheet();
      if (target.closest('a')) return sheet.close();
      // A click on the backdrop (the dialog itself, outside the panel) closes it.
      if (target === sheet) closeSheet();
    });
    // The menu is for phones and tablets: close it if the window grows to the desktop layout.
    // (With enlarged text the bar keeps the Menu button at any width, so the menu stays usable.)

    // D5 (17 Nov 2026, kept): on Home the header button is an outline while the hero's lime button is on screen, so only
    // one lime button shows at a time; it turns lime once the hero button scrolls away. It never moves.
    const quiet = header.querySelector<HTMLElement>('[data-hdr-cta].is-quiet');
    const heroCta = document.querySelector('[data-hero-cta]');
    if (quiet && heroCta) {
      new IntersectionObserver(([en]) => quiet.classList.toggle('is-quiet', en.isIntersecting), { rootMargin: '-72px 0px 0px 0px' }).observe(heroCta);
    }
  }
</script>

<style>
  /* A solid ink bar (Mann, 18 Nov 2026: text scrolling underneath never shows through the wordmark). The layout follows
     the header's own width in rem, so with enlarged text it falls back to the Menu button instead of overflowing. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: site-header;
    container: hdr / inline-size;
    isolation: isolate;
  }
  .hdr::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    opacity: 1;
  }
  .hdr__bar {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: var(--header-h);
  }
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    flex: none;
  }
  .hdr__brand :global(.hdr__logo) {
    height: 1rem;
    width: auto;
  }
  .hdr__live {
    display: none;
    align-items: center;
    gap: 0.6em;
    margin: 0;
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--text-3);
    white-space: nowrap;
  }
  .hdr__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--signal);
  }
  .hdr__sep {
    color: var(--line);
  }
  .hdr__nav {
    display: none;
    margin-left: auto;
  }
  .hdr__nav ul {
    display: flex;
    gap: var(--s-1);
  }
  .hdr__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--s-3);
    font-size: var(--fs-sm);
    font-weight: var(--w-ui);
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .hdr__nav a:hover,
  .hdr__nav a:focus-visible,
  .hdr__nav a[aria-current='page'] {
    color: var(--text);
  }
  /* The current page carries a short piece of the line under its label. */
  .hdr__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: 0.45rem;
    height: 2px;
    background: var(--signal);
  }
  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
  }
  .qm-trigger {
    display: none;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding-inline: var(--s-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
    color: var(--text-2);
    transition: border-color var(--dur-1), color var(--dur-1);
  }
  .qm-trigger:hover,
  .qm-trigger:focus-visible {
    border-color: var(--control);
    color: var(--text);
  }
  .qm-trigger kbd {
    font-family: var(--font-mono);
    font-weight: var(--w-ui);
    font-size: var(--fs-label);
    color: var(--text-3);
  }
  .hdr__actions :global(.hdr__cta) {
    display: none;
  }
  .hdr__actions :global(.hdr__cta.is-quiet) {
    --btn-bg: transparent;
    --btn-fg: var(--text);
    --btn-hover-bg: var(--surface);
    --btn-border: var(--control);
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--tap);
    padding-inline: var(--s-4) var(--s-3);
    border: 1px solid var(--control);
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: var(--w-ui);
    transition: border-color var(--dur-1), background-color var(--dur-1);
  }
  .menu-btn:hover,
  .menu-btn:focus-visible {
    border-color: var(--text);
    background: var(--surface);
  }
  .menu-btn__lines {
    display: grid;
    gap: 5px;
    width: 1.1rem;
  }
  .menu-btn__lines i {
    display: block;
    height: 2px;
    background: currentColor;
  }
  .menu-btn__lines i + i {
    width: 65%;
    justify-self: end;
    background: var(--signal);
  }
  @media (forced-colors: active) {
    .menu-btn__lines i {
      forced-color-adjust: none;
      background: ButtonText;
    }
  }
  .hdr__line {
    position: relative;
    height: 1px;
    background: var(--line);
    view-transition-name: site-line;
  }
  .hdr__line i {
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  /* Reading progress from the page's own scroll timeline (no script); the script fallback sets --p elsewhere. */
  @supports (animation-timeline: scroll()) {
    :global(:root[data-motion='on']) .hdr__line i {
      animation-name: read-progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* Without JavaScript: the links show as a plain row and the Menu button hides. */
  :global(html:not(.js)) .menu-btn {
    display: none;
  }
  :global(html:not(.js)) .hdr__nav {
    display: block;
    overflow-x: auto;
  }
  @container hdr (min-width: 64rem) {
    .hdr__nav,
    .qm-trigger {
      display: flex;
    }
    .hdr__actions {
      margin-left: 0;
    }
    .hdr__actions :global(.hdr__cta) {
      display: inline-flex;
    }
    .menu-btn {
      display: none;
    }
  }
  @container hdr (min-width: 80rem) {
    .hdr__live {
      display: inline-flex;
    }
  }

  /* ── The menu sheet ── */
  .sheet {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--text);
    overscroll-behavior: contain;
  }
  .sheet::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .sheet__inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-5);
    min-height: 100%;
    padding: max(var(--s-4), env(safe-area-inset-top)) var(--gutter) max(var(--s-5), env(safe-area-inset-bottom));
  }
  .sheet__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: calc(var(--header-h) - var(--s-4));
  }
  .sheet__links {
    display: grid;
    align-content: center;
    border-top: 1px solid var(--line);
  }
  .sheet__links li {
    border-bottom: 1px solid var(--line);
  }
  .sheet__links a {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    min-height: 3.25rem;
    padding-block: var(--s-2);
    text-decoration: none;
    color: var(--text);
  }
  .sheet__n {
    width: 2rem;
    font-size: var(--fs-label);
    color: var(--text-3);
  }
  .sheet__label {
    font-family: var(--font-display);
    font-weight: var(--w-display);
    font-size: var(--fs-menu);
    letter-spacing: var(--track-hero);
    line-height: 1.05;
  }
  .sheet__links a:hover .sheet__label,
  .sheet__links a:focus-visible .sheet__label,
  .sheet__links a[aria-current='page'] .sheet__label {
    color: var(--signal);
  }
  .sheet__foot {
    display: grid;
    gap: var(--s-4);
  }
  .sheet__foot :global(.sheet__cta) {
    width: 100%;
  }
  .sheet__reach {
    display: grid;
    gap: var(--s-1);
  }
  .sheet__reach a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    color: var(--text-2);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .sheet__reach a:hover,
  .sheet__reach a:focus-visible {
    color: var(--text);
  }
  .sheet__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
  }
  .sheet__legal a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    color: inherit;
  }
  /* Short screens (down to 320 × 568): the whole menu, down to Privacy and Terms, fits on one screen. */
  @media (max-height: 760px) {
    .sheet__inner {
      gap: var(--s-3);
    }
    .sheet__top {
      min-height: var(--tap);
    }
    .sheet__links a {
      min-height: var(--tap);
      padding-block: 0;
      align-items: center;
    }
    .sheet__label {
      font-size: var(--fs-h3);
    }
    .sheet__foot {
      gap: var(--s-2);
    }
    .sheet__reach {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--s-4);
    }
    .sheet__foot :global(.sheet__cta) {
      min-height: var(--tap);
    }
  }
  @media (max-height: 600px) {
    .sheet__inner {
      padding-top: var(--s-2);
      padding-bottom: var(--s-3);
      gap: var(--s-2);
    }
    .sheet__reach li + li {
      display: none;
    }
    .sheet__label {
      font-size: var(--fs-lead);
    }
  }
  :root[data-motion='on'] .sheet[open] {
    animation: sheet-in var(--dur-3) var(--ease-out);
  }
  :root[data-motion='on'] .sheet[open] .sheet__links li {
    animation: rise var(--dur-4) var(--ease-out) both;
    animation-delay: calc(var(--i) * var(--stagger) * 1.5);
  }
  :root[data-motion='on'] .sheet.is-closing {
    animation: sheet-out var(--dur-2) var(--ease-in) forwards;
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  @keyframes sheet-out {
    to {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>

<style is:global>
  /* The Motion switch (menu and footer). aria-pressed carries the state; the label text says it too. */
  .switch {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 var(--s-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-weight: var(--w-ui);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: border-color var(--dur-1), color var(--dur-1);
  }
  .switch:hover,
  .switch:focus-visible {
    border-color: var(--control);
    color: var(--text);
  }
  .switch__track {
    position: relative;
    width: 2rem;
    height: 1.1rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--control);
  }
  .switch__track i {
    position: absolute;
    top: 50%;
    left: 0.15rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--text-3);
    transform: translateY(-50%);
    transition: transform var(--dur-2) var(--ease-out), background-color var(--dur-2);
  }
  .switch[aria-pressed='true'] .switch__track i {
    transform: translate(0.85rem, -50%);
    background: var(--signal);
  }
  .switch__state {
    min-width: 2.2em;
    color: var(--text);
  }
</style>
