---
/**
 * Scene E, a visual process and a useful next step (DESIGN.md → Homepage → Scene E).
 * Four steps joined by the lime line (it draws as it scrolls in), the published prices as a compact rail, and a short
 * brief: choose what you need, optionally add your website, and continue to the full brief on /contact/ with those
 * answers filled in. It is a hand-off (a GET link), not a second form, so there is one enquiry pipeline. Direct contact
 * sits beside it.
 */
import Icon from '../ui/Icon.astro';
import { packages, priceLabel, priceTerms } from '../../data/packages';
import { emailHref } from '../../lib/contact';

const mail = emailHref();

const steps = [
  { t: 'Send a short brief', d: 'Two minutes. I reply with questions, or say honestly if I’m not the right fit.' },
  { t: 'Agree a written scope', d: 'Deliverables, exclusions, third-party costs and a quote, in writing.' },
  { t: 'Build and check in', d: 'You review drafts, with two rounds of changes per deliverable.' },
  { t: 'Test, launch, hand over', d: 'A real test enquiry, speed and accessibility checks, and every login in your name.' },
];
const needs = [
  { v: 'area-website', l: 'A better website', need: 'website' },
  { v: 'area-found', l: 'Getting found on Google', need: 'found' },
  { v: 'area-follow-up', l: 'Less admin, faster replies', need: 'admin' },
  { v: 'not-sure', l: 'Not sure yet', need: '' },
];
const paid = packages.filter((p) => p.price.amount);
---

<section class="pb section" id="start" aria-labelledby="pb-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div class="pb__head-a">
        <p class="eyebrow">How it works · what it costs</p>
        <h2 id="pb-title" data-split>
          <span class="line-mask" style="--i:0"><span>Four steps,</span></span>
          <span class="line-mask" style="--i:1"><span class="accent">all in writing<span class="stop">.</span></span></span>
        </h2>
      </div>
      <p class="pb__intro">Published prices, a written scope before any work starts, and everything handed over in your name.</p>
    </header>

    <div class="pb__track">
    <svg class="pb__line" viewBox="0 0 1000 20" preserveAspectRatio="none" aria-hidden="true">
      <path class="draw-on-scroll" pathLength="1" d="M0 10 H1000" />
    </svg>
    <ol class="pb__steps" role="list">
      {
        steps.map((s, i) => (
          <li class="pb__step">
            <span class="pb__dot" aria-hidden="true" />
            <span class="pb__i num">0{i + 1}</span>
            <h3 class="pb__t">{s.t}</h3>
            <p class="pb__d">{s.d}</p>
          </li>
        ))
      }
    </ol>
    </div>

    <div class="pb__grid">
      <div class="pb__prices">
        <p class="pb__label mono">Published prices · CAD, plus tax</p>
        <ul class="pb__rail" role="list">
          {
            paid.map((p) => (
              <li>
                <span class="pb__pname">{p.name}</span>
                <span class="pb__price num" data-price>{priceLabel(p).text}</span>
                <span class="pb__terms">{priceTerms(p)}</span>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow" href="/pricing/">Compare what each includes <Icon name="arrow" /></a>
      </div>

      <form class="pb__brief" action="/contact/" method="get" data-mini-brief>
        <input type="hidden" name="from" value="home" />
        <fieldset class="pb__fs">
          <legend class="pb__legend">Start a brief: what do you need?</legend>
          <div class="chips">
            {
              needs.map((n) => (
                <label class="chip">
                  <input type="checkbox" name="services" value={n.v} data-need={n.need} />
                  <span class="chip__box" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="m5 12.5 4.5 4.5L19 7.5" />
                    </svg>
                  </span>
                  {n.l}
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="field">
          <label for="mb-site">Your website, if you have one <span class="subtle">(optional)</span></label>
          <input class="input" id="mb-site" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourbusiness.ca" maxlength="200" />
        </div>
        <div class="pb__submit">
          <button class="btn" type="submit">
            <span class="btn__label"><span>Continue to the brief</span></span>
            <span class="btn__icon" aria-hidden="true"><Icon name="arrow" /></span>
          </button>
          <p class="small subtle">Two more questions on the next page. Nothing is sent until you press Send there.</p>
        </div>
        {mail && <p class="small subtle text-links">Or skip the form: <a href={mail} data-contact="email">email me</a>, or call or message me from the footer below.</p>}
      </form>
    </div>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';

  document.querySelectorAll<HTMLFormElement>('[data-mini-brief]').forEach((form) => {
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="services"]')];
    const pick = (need: string | null) => {
      if (!need || boxes.some((b) => b.checked)) return;
      const b = boxes.find((x) => x.dataset.need === need);
      if (b) b.checked = true;
    };
    try {
      pick(sessionStorage.getItem('mp-need'));
    } catch {
      /* storage blocked */
    }
    addEventListener('needchange', (e) => pick((e as CustomEvent).detail?.need ?? null));

    // With JavaScript the answers travel as one list (?services=a,b) and land on the brief's first step.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const chosen = boxes.filter((b) => b.checked).map((b) => b.value);
      const site = (form.elements.namedItem('website') as HTMLInputElement).value.trim();
      const q = new URLSearchParams();
      if (chosen.length) q.set('services', chosen.join(','));
      if (site) q.set('website', site.slice(0, 200));
      track('brief_start', { need: chosen.join(',') || 'none', location: 'home' });
      location.href = `/contact/${q.size ? `?${q}` : ''}#brief`;
    });
  });
</script>

<style>
  .pb {
    background: var(--ink);
    border-top: 1px solid var(--line);
  }
  .pb__head-a {
    display: grid;
    row-gap: var(--head-gap-1);
  }
  .pb__head-a h2 {
    max-width: none;
  }
  .pb__intro {
    color: var(--text-2);
    max-width: 40ch;
  }
  .pb__track {
    position: relative;
    margin-bottom: clamp(var(--s-8), 7vw, var(--s-10));
  }
  .pb__steps {
    display: grid;
    gap: var(--s-6);
  }
  .pb__line {
    display: none;
  }
  .pb__step {
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding-left: var(--s-6);
  }
  /* Phones: the line runs down the left edge, through each dot. */
  .pb__step::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 1.1rem;
    bottom: calc(var(--s-6) * -1);
    width: 2px;
    background: var(--signal);
  }
  .pb__step:last-child::before {
    content: none;
  }
  .pb__dot {
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--signal);
  }
  .pb__i {
    font-size: var(--fs-label);
    color: var(--signal);
  }
  .pb__t {
    font-family: var(--font-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h3);
    letter-spacing: var(--track-head);
    line-height: 1.1;
  }
  .pb__d {
    max-width: 30ch;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .pb__grid {
    display: grid;
    gap: var(--s-8);
    align-items: start;
  }
  .pb__prices {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .pb__label,
  .pb__legend {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--w-ui);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .pb__rail {
    width: 100%;
    border-top: 1px solid var(--line);
  }
  .pb__rail li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'name price' 'terms terms';
    gap: 0.1rem var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--line);
  }
  .pb__pname {
    grid-area: name;
    font-weight: var(--w-head);
  }
  .pb__price {
    grid-area: price;
    font-size: var(--fs-lead);
    color: var(--text);
  }
  .pb__terms {
    grid-area: terms;
    font-size: var(--fs-label);
    color: var(--text-3);
  }
  .pb__brief {
    display: grid;
    gap: var(--s-5);
    padding: clamp(var(--s-5), 3vw, var(--s-7));
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }
  .pb__fs {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .pb__legend {
    padding: 0;
    margin-bottom: var(--s-3);
  }
  .pb__submit {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }
  @media (min-width: 48em) {
    .pb__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--s-5);
      padding-top: var(--s-6);
    }
    .pb__line {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 0.4rem;
      width: 100%;
      height: 0.9rem;
      overflow: visible;
      fill: none;
    }
    .pb__line path {
      stroke: var(--signal);
      stroke-width: var(--line-w);
      vector-effect: non-scaling-stroke;
    }
    .pb__step {
      padding-left: 0;
      padding-top: var(--s-5);
    }
    .pb__step::before {
      content: none;
    }
    .pb__dot {
      top: calc(var(--s-6) * -1 + 0.4rem);
    }
  }
  @media (min-width: 64em) {
    .pb__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--s-9);
    }
  }
</style>
