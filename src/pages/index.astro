---
/**
 * Home (MANN / IN MOTION): five scenes on one visual grammar, the lime line (DESIGN.md → Homepage).
 *   A Stage       who, what, where, the free check, and the operable stage (three needs)
 *   B WorkReel    real work as moving evidence (ivory)
 *   C Playground  three local demonstrations
 *   D Person      the person behind the work (ivory)
 *   E ProcessBrief four steps, published prices and a short brief hand-off
 * The footer is the final frame.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Stage from '../components/home/Stage.astro';
import WorkReel from '../components/home/WorkReel.astro';
import Playground from '../components/home/Playground.astro';
import Person from '../components/home/Person.astro';
import ProcessBrief from '../components/home/ProcessBrief.astro';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import { packageById, priceLabel } from '../data/packages';
import { businessJsonLd, personJsonLd, websiteJsonLd } from '../lib/seo';

// SEO copy (14 Nov 2026 audit, kept). The price comes from src/data/packages.ts.
const launch = packageById('website-launch')!;
const description = `Websites, local SEO and Google Business Profile setup for Toronto small businesses. Published prices: websites from ${priceLabel(launch).text} CAD. Free website check.`;
---

<BaseLayout
  title="Home"
  fullTitle="Web Design & Local SEO in Scarborough, Toronto | Mann Patel"
  description={description}
  jsonLd={[websiteJsonLd(), businessJsonLd({ withServices: true }), { '@context': 'https://schema.org', ...personJsonLd() }]}
>
  <Stage />
  <WorkReel />
  <!-- Real client reviews only (src/data/reviews.ts); renders nothing until there are some. -->
  <ReviewsStrip />
  <Playground />
  <Person />
  <ProcessBrief />
</BaseLayout>
